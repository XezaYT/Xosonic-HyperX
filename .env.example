# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# Security & CORS
ALLOWED_ORIGINS=*

# Discord Voice Bot Configuration
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Stream & Proxy Caching
CACHE_MAX_AGE_SECONDS=3600
MAX_STREAM_CONCURRENCY=50

# Privacy Radar
RADAR_BROADCAST_INTERVAL_MS=3000
