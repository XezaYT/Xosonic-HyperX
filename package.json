{
  "name": "xosonic-hyperx",
  "version": "1.0.0",
  "description": "High-performance TypeScript backend engine & Discord Voice Bot for Xosonic ecosystem by XrLabs",
  "author": "XrLabs / beatrix.sql",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:bot": "tsx watch src/bot/index.ts",
    "build": "tsup src/index.ts src/bot/index.ts --format esm --dts --clean",
    "start": "node dist/index.js",
    "start:bot": "node dist/bot/index.js",
    "register-commands": "tsx src/bot/deployCommands.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@discordjs/voice": "^0.18.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/websocket": "^11.0.2",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "prism-media": "^1.3.5",
    "undici": "^7.4.0",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/ws": "^8.5.14",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
